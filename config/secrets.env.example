# Copy to /etc/inkyframe/secrets.env (root-owned, mode 600). Never commit the real file.
# A long-lived access token for a dedicated, NON-ADMIN Home Assistant user (Profile > Security > Long-lived tokens).
INKYFRAME_HA_TOKEN=
# Optional: overrides [homeassistant] url in config.toml
#INKYFRAME_HA_URL=http://homeassistant:8123
